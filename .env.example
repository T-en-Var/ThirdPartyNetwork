# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# --- Postgres -----------------------------------------------------------
POSTGRES_DB=tpn
POSTGRES_USER=tpn
POSTGRES_PASSWORD=changeme

# Host "postgres" is the service name on the tpn-internal docker network.
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=tpn;Username=tpn;Password=changeme

# --- Backend (ASP.NET Core) ----------------------------------------------
TOKEN_SECRET=change-this-to-a-long-random-string
DOTNET_ENVIRONMENT=Development
LUCKY_PENNY_LICENSE=

# Local HTTPS domains (see README.md for one-time setup via infra/setup.ps1)
FRONTEND_URL=https://tpn.test
JWT_ISSUER=https://api.tpn.test/
JWT_AUDIENCE=https://tpn.test/

# --- Frontend (Vite) -------------------------------------------------------
VITE_API_BASE_URL=https://api.tpn.test

# --- MinIO ----------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-min-8-chars
MINIO_EXTERNAL_ENDPOINT=cdn.tpn.test
MINIO_EXTERNAL_USE_SSL=true

# --- pgAdmin ----------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=changeme
